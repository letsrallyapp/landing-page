# Loops form endpoint for the waitlist form.
# Copy this file to `.env.local` for local development.
# In production, set this as an environment variable in the Vercel project.
#
# Create a form in Loops (Forms → New form), open the form's Settings tab, and
# copy the "Form Endpoint URL". It looks like the value below. This endpoint only
# accepts contact sign-ups, so it is safe to ship in the browser.
VITE_LOOPS_FORM_ENDPOINT=https://app.loops.so/api/newsletter-form/your-form-id

# iOS App Store numeric id for the invite landing page (/invite/<code>).
# It's the number in https://apps.apple.com/app/id123456789 (digits only).
# When unset, iOS invite links still set the clipboard sentinel and show a
# "get the app" page instead of redirecting to the App Store.
VITE_IOS_APP_STORE_ID=
