# Copy this file to `.env.local` for local development.
# In production, set these as environment variables in the Vercel project.

# iOS App Store numeric id for the invite landing page (/invite/<code>).
# It's the number in https://apps.apple.com/app/id123456789 (digits only).
# Optional: the current id is baked into src/lib/invite.ts, so only set this to
# override it. When neither is a valid id, iOS invite links still set the
# clipboard sentinel and show a "get the app" page instead of redirecting.
VITE_IOS_APP_STORE_ID=
